-- User MySQL theo CONTRACT 8.3. Chạy trên PRIMARY (replica nhận qua binlog). Chạy lại được: đặt lại mật khẩu và quyền.
-- Render bằng envsubst (setup-primary.sh), KHÔNG commit bản đã render.
--   APP_HOSTS   máy web/worker  (cụm: 10.0.2.%)
--   REPL_HOSTS  máy replica     (cụm: 10.0.3.%)
--   LOCAL_HOSTS exporter, backup chạy ngay trên máy MySQL (cụm: 127.0.0.1)

CREATE USER IF NOT EXISTS 'cj_app'@'${APP_HOSTS}' IDENTIFIED BY '${DB_PASSWORD}';
ALTER USER 'cj_app'@'${APP_HOSTS}' IDENTIFIED BY '${DB_PASSWORD}';
GRANT SELECT, INSERT, UPDATE ON cloudjudge.* TO 'cj_app'@'${APP_HOSTS}';

CREATE USER IF NOT EXISTS 'cj_ro'@'${APP_HOSTS}' IDENTIFIED BY '${DB_RO_PASSWORD}';
ALTER USER 'cj_ro'@'${APP_HOSTS}' IDENTIFIED BY '${DB_RO_PASSWORD}';
GRANT SELECT ON cloudjudge.* TO 'cj_ro'@'${APP_HOSTS}';

CREATE USER IF NOT EXISTS 'repl'@'${REPL_HOSTS}' IDENTIFIED BY '${REPL_PASSWORD}';
ALTER USER 'repl'@'${REPL_HOSTS}' IDENTIFIED BY '${REPL_PASSWORD}';
GRANT REPLICATION SLAVE ON *.* TO 'repl'@'${REPL_HOSTS}';

CREATE USER IF NOT EXISTS 'exporter'@'${LOCAL_HOSTS}' IDENTIFIED BY '${EXPORTER_PASSWORD}' WITH MAX_USER_CONNECTIONS 3;
ALTER USER 'exporter'@'${LOCAL_HOSTS}' IDENTIFIED BY '${EXPORTER_PASSWORD}' WITH MAX_USER_CONNECTIONS 3;
GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'${LOCAL_HOSTS}';

CREATE USER IF NOT EXISTS 'backup'@'${LOCAL_HOSTS}' IDENTIFIED BY '${BACKUP_DB_PASSWORD}';
ALTER USER 'backup'@'${LOCAL_HOSTS}' IDENTIFIED BY '${BACKUP_DB_PASSWORD}';
GRANT RELOAD, PROCESS ON *.* TO 'backup'@'${LOCAL_HOSTS}';
GRANT SELECT, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER ON cloudjudge.* TO 'backup'@'${LOCAL_HOSTS}';

FLUSH PRIVILEGES;
