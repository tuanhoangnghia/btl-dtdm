# Copy thành app/dev.env (đã .gitignore) rồi chạy với CJ_ENV_FILE=dev.env. Khớp docker-compose.dev.yml.
CJ_ROLE=web
CJ_RELEASE=dev
DB_PRIMARY_HOST=127.0.0.1
DB_REPLICA_HOST=127.0.0.1
